<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_instructions"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hero_count_label" />

    <Spinner
        android:id="@+id/spinner_hero_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <CheckBox
        android:id="@+id/check_reinforcements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/add_reinforcements" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/post_deploy_wait_label" />

    <EditText
        android:id="@+id/edit_post_deploy_seconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/post_deploy_wait_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/inter_tap_delay_label" />

    <EditText
        android:id="@+id/edit_inter_tap_delay_ms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/inter_tap_delay_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4" />

    <Button
        android:id="@+id/btn_grant_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/grant_overlay_permission" />

    <Button
        android:id="@+id/btn_configure_coordinates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/configure_coordinates" />

    <Button
        android:id="@+id/btn_ocr_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ocr_gallery_open" />

    <Button
        android:id="@+id/btn_start_automation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/start_screen_capture_and_overlay" />

</LinearLayout>
